{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ShopFast capstone 1 - receipts bucket + orders table",
  "Resources": {
    "ReceiptBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "shopfast-receipts-jampol1234",
        "Tags": [{ "Key": "project", "Value": "shopfast" }]
      }
    },
    "OrdersTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "ShopFastOrders",
        "AttributeDefinitions": [
          { "AttributeName": "orderId", "AttributeType": "S" }
        ],
        "KeySchema": [
          { "AttributeName": "orderId", "KeyType": "HASH" }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "Tags": [{ "Key": "team", "Value": "orders" }]
      }
    }
  },
  "Outputs": {
    "BucketName": { "Value": { "Ref": "ReceiptBucket" } },
    "TableName": { "Value": { "Ref": "OrdersTable" } }
  }
}
